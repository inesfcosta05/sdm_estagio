# ============================================
# BASE DE DADOS
# ============================================
# LOCAL: localhost
# PRODUCTION (Railway): containers-us-west-XXX.railway.app
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=wp_migracion
PORT=5000

# ============================================
# FRONTEND (CORS)
# ============================================
# LOCAL:
FRONTEND_URL=http://localhost:3000

# PRODUCTION (adiciona URL do Render):
FRONTEND_URLS=http://localhost:3000,https://seu-frontend.onrender.com

# ============================================
# WORDPRESS SYNC (RECOMENDADO)
# ============================================
# URL da API REST do WordPress (ex: https://sdm.celeuma.pt/wp-json)
WP_API_URL=https://sdm.celeuma.pt/wp-json

# Utilizador e senha do WordPress (para POST requests, se necessário)
WP_API_USER=
WP_API_PASS=

# Intervalo de sincronização em milissegundos (padrão: 300000 = 5 minutos)
SYNC_INTERVAL=300000

# Token secreto para endpoint de sincronização manual
SYNC_SECRET=seu_token_secreto_sync

# Token secreto para webhooks do WordPress
WEBHOOK_SECRET=seu_token_secreto_webhook